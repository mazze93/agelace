meta {
  name: Create board
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/canvases
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno probe board"
  }
}

script:post-response {
  bru.setVar("boardId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.nodes: eq 0
  res.body.entries: isArray
}

docs {
  `{ name }` (trimmed, ≤120 chars). Writes `canvases/<id>.yjs` plus a JSON Canvas copy.
  Emits `{type:"canvas", op:"upsert"}`.
}
